{
  "name": "server",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "build": "tsdown",
    "check-types": "tsc -b",
    "compile": "bun build --compile --minify --sourcemap --bytecode ./src/index.ts --outfile server",
    "dev": "bun run --hot src/index.ts",
    "start": "bun run dist/index.mjs",
    "test": "bun test",
    "test:load": "k6 run tests/load/script.js"
  },
  "dependencies": {
    "@elysiajs/cors": "^1.4.1",
    "@orpc/openapi": "catalog:",
    "@orpc/server": "catalog:",
    "@orpc/zod": "catalog:",
    "@security-demo/api": "workspace:*",
    "@security-demo/auth": "workspace:*",
    "@security-demo/db": "workspace:*",
    "@security-demo/env": "workspace:*",
    "better-auth": "catalog:",
    "dotenv": "catalog:",
    "elysia": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@security-demo/config": "workspace:*",
    "@types/bun": "catalog:",
    "@types/jest": "^30.0.0",
    "@types/k6": "^1.6.0",
    "jest": "^30.3.0",
    "jest-mock-extended": "^4.0.0",
    "ts-jest": "^29.4.6",
    "tsdown": "^0.16.5",
    "typescript": "^5"
  }
}
